# Postgres. Em dev, aponte para o container do compose.
DATABASE_URL=postgres://mural:mural@localhost:5432/mural

# Onde as fotos processadas são gravadas. Em container, é o volume montado.
UPLOAD_DIR=./.uploads

# Usados pelo docker-compose
POSTGRES_USER=mural
POSTGRES_PASSWORD=mural
POSTGRES_DB=mural
APP_PORT=3000
