# Desenvolvimento local. Produção não usa nada disto para o banco: lá o Postgres
# é a instância gerenciada da Cloudez, e o DATABASE_URL dela vem do
# shared/.cloudez.env do site (veja docker-compose.cloudez.yml).

# Conexão do `npm run dev`, rodando fora de container.
# Ajuste a porta para a que o docker-compose.dev.yml publicou.
DATABASE_URL=postgres://mural:mural@localhost:5432/mural

# Onde os arquivos enviados são gravados.
UPLOAD_DIR=./.uploads

# Usados pelo docker-compose em desenvolvimento.
POSTGRES_USER=mural
POSTGRES_PASSWORD=mural
POSTGRES_DB=mural
# Nome da instância, mostrado no título da aba.
SITE_NOME=claudesite02

# Envio de e-mail. Em produção o padrão basta: o container roda com
# network_mode: host e fala com o MTA (exim4) do próprio servidor, sem
# credencial. Fora do servidor não há nada em localhost:25, e o botão de teste
# falha com ECONNREFUSED — que é o comportamento correto, não um defeito.
SMTP_HOST=localhost
SMTP_PORT=25
EMAIL_REMETENTE=nao-responda@claudesite02.afurlan.org

APP_PORT=3000
POSTGRES_PORT=5432
